{
  "name": "trippilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test --grep-invert @screens",
    "e2e:screens": "playwright test --grep @screens",
    "check:bundle": "tsx scripts/check-bundle-secrets.ts",
    "poc": "tsx scripts/poc.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@azure/monitor-opentelemetry": "^1.20.1",
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.31.0",
    "@hookform/resolvers": "^5.9.2",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vis.gl/react-google-maps": "^1.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/mssqlserver": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "msw": "^3.0.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
