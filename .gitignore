# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# PoC 실행 결과 (외부 API 응답 원문)
/poc-output/
/eval-output/

# Playwright
/test-results/
/playwright-report/

# Prisma 생성 클라이언트 (npm install 시 postinstall로 재생성)
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
