# 복사해서 .env.local 로 사용하세요 (커밋 금지). 실제 값은 이 파일에 넣지 않습니다. 검증 스키마: src/lib/env.ts

# --- LLM + Google 검색 그라운딩 (Google AI Studio 키 하나로 공용) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google Maps Platform (서버용·브라우저용 키 분리) ---
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Naver Cloud Platform Maps ---
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# --- Naver Developers 검색 API (지역 검색) ---
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# --- Database ---
# 로컬(docker compose) 예: sqlserver://localhost:1433;database=trippilot;user=sa;password=<MSSQL_SA_PASSWORD>;encrypt=true;trustServerCertificate=true
# Azure SQL 예: sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<pw>;encrypt=true
DATABASE_URL=
# docker-compose.yml 의 로컬 SQL Server sa 비밀번호 (8자 이상, 대·소문자·숫자·기호 중 3종)
MSSQL_SA_PASSWORD=

# --- 관측성 (선택) ---
# Application Insights 연결 문자열. 비우면 원격 측정이 꺼진다 (로컬 기본). 운영은 Bicep이 Container App secret으로 넣는다
APPLICATIONINSIGHTS_CONNECTION_STRING=
# (선택) Google Maps Advanced Marker용 Map ID. 비우면 DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- App ---
# 16자 이상 무작위 문자열. 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ACCESS_TOKEN=
DAILY_TRIP_LIMIT=10
